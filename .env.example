# Copiar a .env.local. Sin DATABASE_URL la app usa PGlite en ./data (base local embebida).
# DATABASE_URL=postgres://...            # Neon (rama de pruebas para local)
# BETTER_AUTH_SECRET=                     # obligatorio en producción
# BETTER_AUTH_URL=https://...             # URL pública en producción
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=   # habilita "Continuar con Google"
# RESEND_API_KEY= / MAIL_FROM="Estudio <no-reply@tudominio>"  # links mágicos, invitaciones y reset; sin clave se imprimen en la consola

# Cuenta de prueba local (solo PGlite): prueba@estudio.test / Prueba-Local-2026
